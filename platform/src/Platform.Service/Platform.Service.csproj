<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compaction (SlidingWindowCompactionStrategy/CompactionTriggers) is [Experimental("MAAI001")] in 1.13.0-preview;
         P2 (copilot-shared-core) uses it deliberately for the framework session window. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.13.0-preview.260703.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 單元測試直接驗證路由表(BuildToolsAsync 產出);其餘皆走公開 API。 -->
    <InternalsVisibleTo Include="Platform.Service.Tests" />
  </ItemGroup>

</Project>
