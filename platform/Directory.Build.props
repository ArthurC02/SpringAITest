<Project>

  <!--
    整個 backend 方案的共用建置設定(對應原 Java 多模組共用的 parent pom 設定)。
    net10.0、可空參考型別、隱含 using 全專案一致,避免每個 csproj 重複宣告。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      刻意不強制 TreatWarningsAsErrors:避免第三方(含 Agent Framework/OpenTelemetry 等)
      傳遞套件的預覽/安全性警告讓整個建置失敗。
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
